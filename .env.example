TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
LEAGUE_SQLITE_PATH=league.db
TELEGRAM_GROUP_ID=-1001234567890

# Google Gemini API для Vision OCR (скриншоты матчей и составов)
# Можно указать 1 ключ или несколько через запятую для ротации Round-Robin и защиты от 429
GEMINI_API_KEY=AIzaSy_ocr_key1,AIzaSy_ocr_key2,AIzaSy_ocr_key3

# Google Gemini API для чата Темшика и аналитики (также поддерживает несколько ключей через запятую)
GEMINI_CHAT_API_KEY=AIzaSy_chat_key1,AIzaSy_chat_key2

# Google Gemini API для генерации постов клуба (поддерживает ротацию через запятую)
# Использует бесплатные модели Gemini 3.1 / 3.5 Flash Lite (500 запросов в день)
GEMINI_SMM_API_KEY=AIzaSy_your_smm_key_here
GEMINI_SMM_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash


# Telegram-канал для публикации постов клуба (юзернейм @channel или ID -100...)
# Можно также привязать интерактивно прямо в боте через команду /set_club_channel
MY_CLUB_CHANNEL=

# OpenRouter — вкладка «ИИ-прогноз» в панели Logovo.bet (https://openrouter.ai/keys)
# Без ключа прогноз строится по вероятностям линии.
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# Бесплатные модели (:free, stealth/*); несколько через запятую — следующая пробуется при ошибке
OPENROUTER_MODEL=qwen/qwen3.8-27b:free,stealth/space-bunny-alpha,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Global Lockdown Mode: true = accessible only to Global Admins; false = regular public mode
LOGOVO_LOCKDOWN=false

# Mini App API rate limiting (защита от флуда и спам-атак)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_READ_RPM=60
API_RATE_LIMIT_WRITE_RPM=20
API_RATE_LIMIT_ADMIN_RPM=120
API_RATE_LIMIT_ANON_RPM=30
# Минимальный интервал (сек) между денежными мутациями одного пользователя
API_SENSITIVE_MIN_INTERVAL=2.0

# Включать ТОЛЬКО когда сервер стоит за nginx/Cloudflare: иначе X-Forwarded-For
# подделывается и лимит по IP обходится одной строкой заголовка
API_TRUST_PROXY_HEADERS=false

# OCR плашек мобильного трекера (отключено для экономии Gemini API)
TRACKER_OCR_ENABLED=false

# Детектор договорных матчей (Integrity Engine).
# Только флаг + экран у супер-админа, ставки никогда не блокируются.
INTEGRITY_ENABLED=true
# Ставки ниже порога не анализируются (монеты)
INTEGRITY_MIN_STAKE=500
# С какого балла дело дублируется в ленту risk_alerts
INTEGRITY_ALERT_THRESHOLD=70

# Долгосрочные ставки: момент (МСК) закрытия приёма для дивизионов, их кубков и бомбардиров.
# Общий кубок закрывается сам, с началом 1/4 финала. Пусто — без срока.
OUTRIGHT_BETS_CLOSE_AT=2026-09-30 18:00:00

# Бэкап базы: сжатая копия league.db, проверенная PRAGMA quick_check.
# Каталог (относительный — от корня проекта). В Docker вынесите его на том.
BACKUP_DIR=backups
# Раз в сколько часов делать копию; 0 — автобэкап выключен (/backup работает всегда)
BACKUP_INTERVAL_HOURS=24
# Сколько последних копий хранить
BACKUP_KEEP=14
# Приватный чат для отправки каждой автокопии файлом (пусто — не отправлять)
BACKUP_TELEGRAM_CHAT_ID=

# Алерты фоновых джобов: глобальным админам после N падений подряд, не чаще раза в N часов
JOB_ALERT_AFTER_FAILURES=3
JOB_ALERT_COOLDOWN_HOURS=6

# Трансферное окно: Telegram ID единственного ответственного (окно, бюджеты, заявки)
TRANSFER_MANAGER_ID=

# IRL-ставки: реальные футбольные матчи по котировкам букмекеров (The Odds API)
IRL_ENABLED=true
ODDS_API_KEY=your_the_odds_api_key_here
IRL_BOOKMAKER_ID=1

