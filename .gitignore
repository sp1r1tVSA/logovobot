# ==============================================================================
# Environment & Secrets
# ==============================================================================
.env
.env.*
!.env.example

# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
coverage/
htmlcov/
.coverage
.coverage.*

venv/
.venv/
env/
.env/
ENV/

# ==============================================================================
# Databases (SQLite & Journal/WAL Artifacts)
# ==============================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
league.db
server_league.db
# Timestamped copies pulled from the server for local debugging — real user data.
# `*.db` does not match these: the extension is .bak-<timestamp>, not .db
*.db.bak-*
*.db.bak

# ==============================================================================
# Telegram Sessions
# ==============================================================================
*.session
*.session-journal

# ==============================================================================
# Logs & Text Dumps (excluding critical project configs)
# ==============================================================================
*.log
*.txt
!requirements.txt
!requirements*.txt
!**/LICENSE.txt

# ==============================================================================
# Root Test Media & Artifacts (preserves assets/ directory)
# ==============================================================================
/*.mp4
/*.mov
/*.avi
/*.mkv
/*.jpg
/*.jpeg
/*.png
/*.webp
test_*.png

# Dynamic Caches & Generation Output
assets/players/
assets/tmp_crops/
assets/cards_preview/
# Листы для глазной проверки лиц, scripts/fetch_squad_photos.py --contact-sheet
assets/contact_sheets/
# Club crests — fetched by scripts/download_logos.py, synced to the server separately
assets/logos/
players_cache/
sandbox/output/
state/
artifacts/

# ==============================================================================
# Frontend & Build Artifacts
# ==============================================================================
node_modules/
dist/
npm-debug.log*

# ==============================================================================
# IDE & System Files
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ==============================================================================
# Claude Code (share project config, ignore local state and caches)
# ==============================================================================
# Config (agents, commands, skills, guides, prds) is tracked by default so a
# newly installed tool cannot go missing silently. Only local state is ignored.
.claude/settings.local.json
.claude/cache/
.claude/paste-cache/
.claude/sessions/
.claude/shell-snapshots/
.claude/session-env/
.claude/backups/
.claude/todos/
.claude/statsig/
.claude/history.jsonl
.claude/*.log

# ==============================================================================
# Agent Tooling (vendored ECC framework — local only, not project source)
# ==============================================================================
.agents/*
!.agents/AGENTS.md
